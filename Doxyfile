# --- PROJEKT ---
# Zostawiłem Twoją nazwę ART, ale jeśli prowadzący wymagał "2Ow1L", możesz to zmienić.
PROJECT_NAME           = "Analizator Ruchu Tramwajowego (ART)"
PROJECT_NUMBER         = 0.1
OUTPUT_DIRECTORY       = doc
OUTPUT_LANGUAGE        = Polish
DOXYFILE_ENCODING      = UTF-8
TAB_SIZE               = 8

# --- BUDOWANIE (WYMAGANIA PROWADZĄCEGO) ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_CLASSES  = YES
SHOW_INCLUDE_FILES     = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = YES
