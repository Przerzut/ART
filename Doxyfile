FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES
EXCLUDE                = build AnalizatorTramwajowy_autogen

# --- WYGLĄD HTML ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
DISABLE_INDEX          = NO

# --- DIAGRAMY I GRAFY (ŚCISŁE WYTYCZNE Z PLIKU PROWADZĄCEGO) ---
